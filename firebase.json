{
  "hosting": {
    "public": "dist",
    "rewrites": [{ "source": "/about", "destination": "/index.html" }],
    "headers": [
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/firebase.config.local.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/probe.txt", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "remoteconfig": { "template": "remoteconfig.template.json" }
}
